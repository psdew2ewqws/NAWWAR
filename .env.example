# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================

# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY=your-secret-key-here-change-in-production

# DEBUG - Set to False in production
DEBUG=True

# ALLOWED_HOSTS - Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0


# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Production Database
# Database Name: django_blog_db
# Username: django_blog_db
# Password: admin123
# Host: localhost
# Port: 5432

DB_NAME=django_blog_db
DB_USER=django_blog_db
DB_PASSWORD=admin123
DB_HOST=localhost
DB_PORT=5432

# SQLite (for development only)
# Comment out PostgreSQL settings above and Django will use SQLite by default


# =============================================================================
# API & CORS SETTINGS
# =============================================================================

# CORS - Cross-Origin Resource Sharing
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API Rate Limiting (requests per hour)
API_RATE_LIMIT=1000/hour

# API Base URL (for production)
API_BASE_URL=http://localhost:8000/api/v1


# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Email Backend - SMTP for production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Default From Email
DEFAULT_FROM_EMAIL=noreply@yourdomain.com


# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Redis Cache (for production)
REDIS_URL=redis://127.0.0.1:6379/1

# Local Memory Cache (for development - uncomment to use)
# CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache


# =============================================================================
# SECURITY SETTINGS (Production)
# =============================================================================

# HTTPS/SSL Settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False


# =============================================================================
# LOGGING
# =============================================================================

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# =============================================================================
# THIRD-PARTY API KEYS (Add your API keys here)
# =============================================================================

# Example API Keys
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# STRIPE_PUBLIC_KEY=your-stripe-public-key
# STRIPE_SECRET_KEY=your-stripe-secret-key
# SENDGRID_API_KEY=your-sendgrid-api-key


# =============================================================================
# MEDIA & STATIC FILES
# =============================================================================

# Media files (user uploads)
MEDIA_ROOT=/home/admin/Desktop/django_best_practices/media
MEDIA_URL=/media/

# Static files
STATIC_ROOT=/home/admin/Desktop/django_best_practices/staticfiles
STATIC_URL=/static/


# =============================================================================
# DATABASE CONNECTION STRING EXAMPLES
# =============================================================================

# Production PostgreSQL (Current Configuration)
# postgresql://django_blog_db:admin123@localhost:5432/django_blog_db

# Development SQLite
# sqlite:///db.sqlite3

# Remote PostgreSQL
# postgresql://username:password@host:port/database_name

# PostgreSQL with SSL
# postgresql://username:password@host:port/database_name?sslmode=require
